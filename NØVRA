stock:99,
sizes:["ONE SIZE"],
description:"Minimal urban cap."
},

{
id:7,
name:"Travel Organizer",
category:"LIFESTYLE",
price:18.90,
oldPrice:27.90,
tag:"NUEVO",
image:"",
stock:99,
sizes:[],
description:"Useful organizer for travel."
},

{
id:8,
name:"Desk Setup Stand",
category:"TECH",
price:26.90,
oldPrice:39.90,
tag:"",
image:"",
stock:99,
sizes:[],
description:"Minimal stand for your desk setup."
}

];

let products=[...productsData];

let cart=JSON.parse(
localStorage.getItem("novra_cart")||"[]"
);

let favorites=JSON.parse(
localStorage.getItem("novra_favorites")||"[]"
);

let selectedProduct=null;

let selectedSize="";

let currentCategory="ALL";

async function loadProducts(){

const {data,error}=
await supabaseClient
.from("products")
.select("*")
.order("created_at",{ascending:false});

if(error){

console.error(
"Supabase products error:",
error
);

showToast(
"No se pudieron cargar los productos"
);

return;

}

if(data && data.length){

productsData.length=0;

data.forEach(p=>{

productsData.push({

id:p.id,

name:p.name,

category:p.category,

price:Number(p.price),

oldPrice:
p.old_price!==null &&
p.old_price!==undefined
?Number(p.old_price)
:Number(p.price),

tag:
p.is_new
?"NUEVO"
:p.is_sale
?"OFERTA"
:"",

image:p.image||"",

sizes:Array.isArray(p.sizes)
?p.sizes
:[],

stock:
Number.isFinite(Number(p.stock))
?Number(p.stock)
:0,

description:
p.description||""

});

});

products=[...productsData];

renderProducts();

}

}

function save(){

localStorage.setItem(
"novra_cart",
JSON.stringify(cart)
);

localStorage.setItem(
"novra_favorites",
JSON.stringify(favorites)
);

updateBadges();

}

function updateBadges(){

document.getElementById("cartCount")
.textContent=
cart.reduce(
(a,b)=>a+b.quantity,
0
);

document.getElementById("favCount")
.textContent=
favorites.length;

}

function getProductStock(id){

let p=
productsData.find(x=>x.id===id);

if(!p)
return 0;

return Number(p.stock)||0;

}

function getCartQuantity(id,size){

return cart
.filter(x=>
x.id===id &&
x.size===size
)
.reduce(
(s,x)=>s+x.quantity,
0
);

}

function renderProducts(list=products){

const box=
document.getElementById("products");

if(!list.length){

box.innerHTML=
'<div class="empty">No se encontraron productos.</div>';

return;

}

box.innerHTML=list.map(p=>`

<div class="product">

<div class="product-image">

${
p.image
?`<img src="${p.image}">`
:`<div class="placeholder">NØVRA</div>`
}

${
p.tag
?`<span class="product-tag">${p.tag}</span>`
:""
}

<button
class="favorite"
onclick="toggleFavorite(${p.id})">

${
favorites.includes(p.id)
?"♥"
:"♡"
}

</button>

</div>

<div class="product-info">

<div class="product-name">
${p.name}
</div>

<div class="product-category">
${p.category}
</div>

<div class="price-row">

<span class="price">
€${p.price.toFixed(2)}
</span>

<span class="old-price">
€${p.oldPrice.toFixed(2)}
</span>

</div>

<button
class="add"
onclick="openProduct(${p.id})">

VER PRODUCTO

</button>

</div>

</div>

`).join("");

}
function openProduct(id){

selectedProduct=
productsData.find(p=>p.id===id);

if(!selectedProduct){

showToast("Producto no encontrado");

return;

}

selectedSize=
selectedProduct.sizes &&
selectedProduct.sizes.length
?selectedProduct.sizes[0]
:"";

let sizes=
selectedProduct.sizes &&
selectedProduct.sizes.length
?selectedProduct.sizes.map(s=>`

<button
class="size ${s===selectedSize?"selected":""}"
onclick="selectSize('${s}',this)">
${s}
</button>

`).join("")
:"";

document.getElementById("productDetail")
.innerHTML=`

<div class="modal-head">

<h2>PRODUCTO</h2>

<button
class="close"
onclick="closeModal('productOverlay')">
×
</button>

</div>

<div class="detail-image">

${
selectedProduct.image
?`<img src="${selectedProduct.image}">`
:`<div class="placeholder">NØVRA</div>`
}

</div>

<div class="detail-name">
${selectedProduct.name}
</div>

<div class="detail-description">
${selectedProduct.description}
</div>

<div class="detail-price">
€${selectedProduct.price.toFixed(2)}
</div>

${sizes
?`<div class="sizes">${sizes}</div>`
:""}

<button
class="detail-add"
onclick="addToCart()">

AÑADIR AL CARRITO

</button>

`;

document
.getElementById("productOverlay")
.classList.add("show");

}

function selectSize(size,button){

selectedSize=size;

document
.querySelectorAll(".size")
.forEach(x=>
x.classList.remove("selected")
);

button.classList.add("selected");

}

function addToCart(){

if(!selectedProduct){

showToast("Producto no seleccionado");

return;

}

if(
selectedProduct.sizes &&
selectedProduct.sizes.length &&
!selectedSize
){

showToast("Selecciona una talla");

return;

}

let size=
selectedSize||"";

let current=
getCartQuantity(
selectedProduct.id,
size
);

let stock=
getProductStock(
selectedProduct.id
);

if(
stock>0 &&
current>=stock
){

showToast(
"No hay más stock disponible"
);

return;

}

let found=cart.find(
x=>
x.id===selectedProduct.id &&
x.size===size
);

if(found){

if(stock>0 && found.quantity>=stock){

showToast(
"No hay más stock disponible"
);

return;

}

found.quantity++;

}else{

cart.push({

id:selectedProduct.id,

name:selectedProduct.name,

price:selectedProduct.price,

size:size,

quantity:1,

image:selectedProduct.image

});

}

save();

closeModal("productOverlay");

showToast("Añadido al carrito");

}

function openCart(){

renderCart();

document
.getElementById("cartOverlay")
.classList.add("show");

}

function renderCart(){

const box=
document.getElementById("cartContent");

if(!cart.length){

box.innerHTML=
'<div class="empty">Tu carrito está vacío.</div>';

return;

}

box.innerHTML=
cart.map((item,i)=>`

<div class="cart-item">

<div class="cart-img">

${
item.image
?`<img src="${item.image}">`
:`<div>NØ</div>`
}

</div>

<div class="cart-info">

<div class="cart-name">
${item.name}
</div>

<div class="cart-size">
${item.size||""}
</div>

<div class="cart-price">
€${(item.price*item.quantity).toFixed(2)}
</div>

<div class="qty">

<button
onclick="changeQuantity(${i},-1)">
−
</button>

<span>
${item.quantity}
</span>

<button
onclick="changeQuantity(${i},1)">
+
</button>

<button
class="remove"
onclick="removeCartItem(${i})">

ELIMINAR

</button>

</div>

</div>

</div>

`).join("");

let subtotal=
cart.reduce(
(s,x)=>s+x.price*x.quantity,
0
);

box.innerHTML+=`

<div class="total-box">

<div class="total-line final">

<span>Total</span>

<strong>
€${subtotal.toFixed(2)}
</strong>

</div>

<button
class="checkout-btn"
onclick="openCheckout()">

FINALIZAR COMPRA

</button>

</div>

`;

}
function changeQuantity(i,n){

let item=cart[i];

if(!item)
return;

if(n>0){

let stock=
getProductStock(item.id);

if(
stock>0 &&
item.quantity>=stock
){

showToast(
"No hay más stock disponible"
);

return;

}

}

cart[i].quantity+=n;

if(cart[i].quantity<=0)
cart.splice(i,1);

save();

renderCart();

}

function removeCartItem(i){

cart.splice(i,1);

save();

renderCart();

}

function toggleFavorite(id){

if(favorites.includes(id)){

favorites=
favorites.filter(x=>x!==id);

}else{

favorites.push(id);

}

save();

renderProducts();

}

function openFavorites(){

let list=
productsData.filter(
p=>favorites.includes(p.id)
);

document.getElementById("favoritesContent")
.innerHTML=list.length
?list.map(p=>`

<div class="cart-item">

<div class="cart-info">

<div class="cart-name">
${p.name}
</div>

<div class="cart-price">
€${p.price.toFixed(2)}
</div>

<button
class="add"
onclick="openProduct(${p.id});closeModal('favoritesOverlay')">

VER PRODUCTO

</button>

</div>

</div>

`).join("")
:'<div class="empty">Todavía no tienes favoritos.</div>';

document
.getElementById("favoritesOverlay")
.classList.add("show");

}

function openCheckout(){

if(!cart.length){

showToast("Tu carrito está vacío");

return;

}

closeModal("cartOverlay");

let subtotal=
cart.reduce(
(s,x)=>s+x.price*x.quantity,
0
);

document.getElementById("checkoutSubtotal")
.textContent=
"€"+subtotal.toFixed(2);

document.getElementById("checkoutShipping")
.textContent=
"€0.00";

document.getElementById("checkoutTotal")
.textContent=
"€"+subtotal.toFixed(2);

document
.getElementById("checkoutOverlay")
.classList.add("show");

}

function paymentChanged(){

let method=
document.querySelector(
'input[name="payment"]:checked'
)?.value;

let box=
document.getElementById("referenceBox");

if(
method==="BANGE"||
method==="MUNI_DINERO"
)
box.classList.add("show");
else
box.classList.remove("show");

}

function createOrderNumber(){

let d=new Date();

let year=d.getFullYear();

let month=
String(d.getMonth()+1)
.padStart(2,"0");

let day=
String(d.getDate())
.padStart(2,"0");

let hour=
String(d.getHours())
.padStart(2,"0");

let minute=
String(d.getMinutes())
.padStart(2,"0");

let second=
String(d.getSeconds())
.padStart(2,"0");

return "NV-"+year+"-"+month+day+
"-"+hour+minute+second;

}

async function submitOrder(e){

e.preventDefault();

if(!cart.length){

showToast(
"Tu carrito está vacío"
);

return;

}

let subtotal=
cart.reduce(
(s,x)=>s+x.price*x.quantity,
0
);

let shipping=0;

let total=
subtotal+shipping;

let method=
document.querySelector(
'input[name="payment"]:checked'
)?.value||"";

if(!method){

showToast(
"Selecciona un método de pago"
);

return;

}

let customerNameValue=
document.getElementById("customerName").value.trim();

let customerEmailValue=
document.getElementById("customerEmail").value.trim();

let customerPhoneValue=
document.getElementById("customerPhone").value.trim();

let customerCountryValue=
document.getElementById("customerCountry").value;

let customerAddressValue=
document.getElementById("customerAddress").value.trim();

let paymentReferenceValue=
document.getElementById("paymentReference").value.trim();

let orderNumber=
createOrderNumber();

let button=
document.querySelector(
'#checkoutForm .checkout-btn'
);

button.disabled=true;

button.textContent=
"PROCESANDO...";

try{

for(const item of cart){

let product=
productsData.find(
p=>p.id===item.id
);

if(!product){

throw new Error(
"Producto no encontrado: "+item.name
);

}

let stock=
Number(product.stock)||0;

if(
stock>0 &&
item.quantity>stock
){

throw new Error(
"No hay stock suficiente para: "+
item.name
);

}

}

const customerResult=
await supabaseClient
.from("customers")
.insert({

name:customerNameValue,

email:customerEmailValue,

phone:customerPhoneValue,

country:customerCountryValue,

address:customerAddressValue

})
.select("id")
.single();

if(customerResult.error){

throw customerResult.error;

}

const orderResult=
await supabaseClient
.from("orders")
.insert({

order_number:orderNumber,

customer_name:customerNameValue,

customer_email:customerEmailValue,

customer_phone:customerPhoneValue,

customer_country:customerCountryValue,

customer_address:customerAddressValue,

payment_method:method,

payment_reference:
paymentReferenceValue||null,

subtotal:subtotal,

shipping:shipping,

total:total,

payment_status:
method==="CARD"
?"pending"
:"pending",

order_status:"new"

})
.select("id")
.single();

if(orderResult.error){

throw orderResult.error;

}

const orderId=
orderResult.data.id;

const itemsData=
cart.map(item=>({

order_id:orderId,

product_id:item.id,

product_name:item.name,

size:item.size||null,

quantity:item.quantity,

price:item.price

}));

const itemsResult=
await supabaseClient
.from("order_items")
.insert(itemsData);

if(itemsResult.error){

throw itemsResult.error;

}

for(const item of cart){

let product=
productsData.find(
p=>p.id===item.id
);

if(!product)
continue;

let stock=
Number(product.stock)||0;

if(stock<=0)
continue;

let newStock=
stock-item.quantity;

const updateResult=
await supabaseClient
.from("products")
.update({
stock:newStock
})
.eq("id",item.id);

if(updateResult.error){

console.error(
"Stock update error:",
updateResult.error
);

}

product.stock=newStock;

}

cart=[];

save();

document
.getElementById("checkoutForm")
.reset();

document.getElementById("referenceBox")
.classList.remove("show");

closeModal("checkoutOverlay");

showToast(
"Pedido "+orderNumber+" creado. En proceso."
);

console.log(
"Pedido creado:",
orderNumber
);

}catch(error){

console.error(
"Order error:",
error
);

showToast(
"Error al crear el pedido"
);

}finally{

button.disabled=false;

button.textContent=
"REALIZAR PEDIDO";

}

}
function filterCategory(category,button){

currentCategory=category;

document
.querySelectorAll(".category")
.forEach(x=>
x.classList.remove("active")
);

button.classList.add("active");

products=
category==="ALL"
?[...productsData]
:productsData.filter(
p=>p.category===category
);

renderProducts();

}

function toggleSearch(){

document
.getElementById("searchBox")
.classList.toggle("show");

document
.getElementById("searchInput")
.focus();

}

function searchProducts(){

let q=
document
.getElementById("searchInput")
.value
.toLowerCase()
.trim();

let base=
currentCategory==="ALL"
?[...productsData]
:productsData.filter(
p=>p.category===currentCategory
);

if(!q){

renderProducts(base);

return;

}

renderProducts(
base.filter(p=>
p.name.toLowerCase().includes(q)||
p.category.toLowerCase().includes(q)||
(p.description||"")
.toLowerCase()
.includes(q)
)
);

}

function sortProducts(){

let v=
document.getElementById("sortSelect")
.value;

let list=[...products];

if(v==="low")
list.sort(
(a,b)=>a.price-b.price
);

if(v==="high")
list.sort(
(a,b)=>b.price-a.price
);

renderProducts(list);

}

function closeModal(id){

document
.getElementById(id)
.classList.remove("show");

}

function showToast(message){

let t=
document.getElementById("toast");

t.textContent=message;

t.classList.add("show");

setTimeout(
()=>t.classList.remove("show"),
2200
);

}

async function initializeStore(){

updateBadges();

renderProducts();

await loadProducts();

updateBadges();

}

initializeStore();

</script>

